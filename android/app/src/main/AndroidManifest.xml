<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Flutter's template declares this in the debug and profile manifests
         only, for the VM service. A release build takes its permissions from
         here, so without it every network call fails once shipped: the API,
         Cognito, Firebase, Stripe and the map tiles. -->
    <uses-permission
        android:name="android.permission.INTERNET"/>
    <!-- Coarse only: "nearest shops" needs the neighbourhood, not the door. -->
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Where a push lands when it names no channel of its own, and the
             channel the system falls back to for a notification that arrives
             while the app is not running. `MainActivity` creates it; the
             notifications Lambda names the same id on every message. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="bookings"/>
        <!-- The status-bar icon. Android draws a small icon from its alpha
             alone and fills the shape with the accent colour below, so this
             drawable is the B in flat white on transparent — cut from the
             themed-icon monochrome layer, re-padded to 24dp with Material's
             2dp margin. Without it Firebase falls back to the launcher icon,
             which is a full-colour square: flattened to its alpha that is a
             solid block, and the push arrives as a white square. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_booknow"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent"/>
        <!-- Home screen widgets. Small, medium and large of the same two. -->
        <receiver
            android:name=".widget.CustomerSmallWidget"
            android:label="@string/widget_customer_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_customer_small"/>
        </receiver>
        <receiver
            android:name=".widget.CustomerMediumWidget"
            android:label="@string/widget_customer_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_customer_medium"/>
        </receiver>
        <receiver
            android:name=".widget.OwnerSmallWidget"
            android:label="@string/widget_owner_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_owner_small"/>
        </receiver>
        <receiver
            android:name=".widget.OwnerMediumWidget"
            android:label="@string/widget_owner_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_owner_medium"/>
        </receiver>
        <receiver
            android:name=".widget.OwnerLargeWidget"
            android:label="@string/widget_owner_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_owner_large"/>
        </receiver>
        <!-- Google Pay refuses to hand back a payment token to an app that has
             not declared it uses the Wallet API, so the sheet would show the
             button and then fail on tap. -->
        <meta-data
            android:name="com.google.android.gms.wallet.api.enabled"
            android:value="true"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action
                android:name="android.intent.action.PROCESS_TEXT"/>
            <data
                android:mimeType="text/plain"/>
        </intent>
        <!-- What the help screen hands to the phone: the browser for Termini
             and Privacy, the dialler for the shop's number, the mail app for
             a message to support. Android 11 hides packages an app has not
             declared, and without these url_launcher cannot resolve one. -->
        <intent>
            <action
                android:name="android.intent.action.VIEW"/>
            <data
                android:scheme="https"/>
        </intent>
        <intent>
            <action
                android:name="android.intent.action.DIAL"/>
            <data
                android:scheme="tel"/>
        </intent>
        <intent>
            <action
                android:name="android.intent.action.SENDTO"/>
            <data
                android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>