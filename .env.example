# Local development against a backend running on your own machine.
# Selected with: flutter run --dart-define=ENV=local
ENVIRONMENT=local
API_URL=http://localhost:3000/v1
DEBUG_MODE=true
LOG_LEVEL=debug

# Stripe's publishable key is safe to ship — it is public by design and only
# ever creates payment methods. The secret key belongs on the server and must
# never appear in this file: everything here is readable by anyone who unzips
# the built app.
STRIPE_PUBLISHABLE_KEY=
STRIPE_MERCHANT_ID=

# Cognito hosted login — see .env.development for where the values come from.
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
COGNITO_REDIRECT_URI=booknow://auth/callback
COGNITO_LOGOUT_URI=booknow://auth/logout

# Help and contacts. Public: the app prints the address and the links on the
# help screen.
SUPPORT_EMAIL=support@book-now.org
TERMS_URL=https://book-now.org/terms-of-use
PRIVACY_URL=https://book-now.org/privacy-policy
